{
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "order": "align",
      "items": {
        "type": "object",
        "properties": {
          "id":   {"type": "string", "idScope": "entity"},
          "type": {"type": "string", "score": "exact"},
          "mentions": {
            "type": "array",
            "order": "align",
            "items": {
              "type": "object",
              "properties": {
                "text": {"type": "string", "score": "exact"}
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "order": "align",
      "items": {
        "type": "object",
        "properties": {
          "subject":   {"type": "string", "ref": "entity"},
          "predicate": {"type": "string", "score": "exact"},
          "object":    {"type": "string", "ref": "entity"}
        }
      }
    }
  }
}
