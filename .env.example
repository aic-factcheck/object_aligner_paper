# Copy to `.env` and fill in. Loaded automatically via python-dotenv.
#
# --- Reflection LM (prompt proposer for GEPA) ------------------------------
# The paper uses a frozen GPT-5 reflection LM via the OpenAI API. The config
# (config/experiment.yaml) reads the key from the env var named below.
OPENAI_API_KEY=sk-...

# --- Task LM (the model being optimized) -----------------------------------
# The paper serves local Gemma-4 / Qwen3.5 models behind an OpenAI-compatible
# endpoint (e.g. vLLM). Point these at your own server. They override
# config/experiment.yaml's `task_lm` block.
OAEXP_TASK_LM_BASE_URL=http://127.0.0.1:8000/v1
OAEXP_TASK_LM_MODEL=google/gemma-4-26B-A4B-it
# If your task-LM endpoint needs auth, set the NAME of the env var holding its
# key (leave unset for a keyless local server):
# OAEXP_TASK_LM_API_KEY_ENV=TASK_LM_API_KEY

# --- Optional: override the reflection LM from the environment --------------
# OAEXP_REFLECTION_LM_BASE_URL=https://api.openai.com/v1
# OAEXP_REFLECTION_LM_MODEL=gpt-5

# --- Optional: use a different LM config YAML ------------------------------
# OAEXP_CONFIG=config/experiment.yaml
